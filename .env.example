# Postgres (shared instance, database job_unified_matching). Set in Vercel and as a GitHub Actions secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional: Adzuna API (https://developer.adzuna.com). The crawler skips Adzuna when unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# apps/web (build time): base URL the SPA calls for the API. "" = same origin (production, proxied by Caddy).
# In dev, point it at the local API, e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
