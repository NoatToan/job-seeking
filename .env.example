# Postgres (shared instance, database job_unified_matching). Set in Vercel and as a GitHub Actions secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional: Adzuna API (https://developer.adzuna.com). The crawler skips Adzuna when unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# apps/web (build time): base URL the SPA calls for the API. "" = same origin (production, proxied by Caddy).
# In dev, point it at the local API, e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=
# Optional: Sentry DSN for apps/api error reporting (docs/product/SECURITY.md). Unset = no Sentry,
# structured JSON logs with request id are still emitted either way.
SENTRY_DSN=
# apps/mcp (user's own machine, M3-08): a personal access token from the web app's Account page,
# so the user's own Claude can call their unified-job-crawler API. Unset = those tools just don't
# appear; the free-source tools (SEEK, We Work Remotely, Arc.dev) work either way. Never commit a
# real token.
UJC_API_URL=
UJC_TOKEN=
