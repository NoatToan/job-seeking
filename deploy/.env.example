# Copy to deploy/.env (gitignored) and fill in real values. Never commit deploy/.env.
# Used by: docker compose -f deploy/compose.yml --env-file deploy/.env up -d --build

# --- Postgres (the "postgres" service) ---
POSTGRES_USER=ujc
POSTGRES_PASSWORD=
POSTGRES_DB=job_unified_matching

# --- apps/api (required) ---
# Must point at the "postgres" service, e.g.:
# postgresql://ujc:<same value as POSTGRES_PASSWORD>@postgres:5432/job_unified_matching
DATABASE_URL=
# HMAC key for OTP code hashes and the CSRF token. Generate with: openssl rand -hex 32
UJC_SECRET_KEY=

# --- apps/api (optional) ---
UJC_LOG_LEVEL=INFO
# Never set these two to true/non-empty in a public deployment (see apps/api/README.md).
UJC_OTP_REVIEW_MODE=false
UJC_OTP_REVIEW_ALLOWLIST=
# Resend (https://resend.com) API key; without it, OTP emails only work in review mode and
# ujc_api.digest only logs "would send" (never emails).
RESEND_API_KEY=
UJC_MAIL_FROM=
# Absolute origin used in digest email links (see more / settings / unsubscribe), e.g.
# https://jobs.example.com. No trailing slash.
UJC_PUBLIC_URL=
# Adzuna API (https://developer.adzuna.com); the crawler/worker skip Adzuna when unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Upwork OAuth connect + live search (M3-04): off until an approved API key exists. All
# /api/connections/upwork/* and /api/upwork/* routes 404 "not_enabled" otherwise.
UPWORK_ENABLED=false
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=

# --- apps/web (build-time) ---
# "" (default, same origin) is correct for this stack: Caddy proxies /api/* to the api service.
NEXT_PUBLIC_API_BASE_URL=

# --- deploy/compose.yml (optional) ---
# Host port the "web" (Caddy) service is published on.
WEB_PORT=8080
